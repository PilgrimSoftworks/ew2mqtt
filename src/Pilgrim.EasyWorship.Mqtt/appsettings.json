{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Ew2Mqtt": "Debug"
    }
  },
  "Ew2Mqtt": {
    "InstanceId": "default",
    "EasyWorship": {
      "DiscoveryMode": "AutoThenManual",
      "Host": null,
      "Port": null,
