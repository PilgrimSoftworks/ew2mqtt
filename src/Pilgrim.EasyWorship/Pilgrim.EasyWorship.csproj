<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Pilgrim.EasyWorship</RootNamespace>
    <AssemblyName>Pilgrim.EasyWorship</AssemblyName>
    <PackageId>Pilgrim.EasyWorship</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Cross-platform .NET client for the undocumented EasyWorship "ezwremote" TCP API. Not affiliated with or endorsed by Softouch Development, Inc.; "EasyWorship" is their trademark, used here only to describe interoperability.</Description>
    <PackageTags>easyworship;ezwremote;mqtt;worship</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.IO.Pipelines" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
